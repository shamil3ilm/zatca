APP_NAME=Masaar
# Safe-by-default: a deployment seeded from this file starts in production mode
# with debug off. For local development set APP_ENV=local and APP_DEBUG=true.
# The application refuses to boot with APP_ENV=production and APP_DEBUG=true,
# because debug mode returns internal error detail through the API.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT Authentication
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# HS256 signs and verifies with the same secret, so every service that reads a
# token can also mint one. Set JWT_ALGO=RS256 with a key pair to make issuing
# and verifying separate abilities.
JWT_ALGO=HS256
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
# JWT_PASSPHRASE=

# Clock skew tolerated when checking expiry, in seconds. Above zero, an expired
# token stays usable for that long.
JWT_LEEWAY=0

# Lets a token be revoked before it expires — needed for sign-out to end a
# session rather than only forget it client-side.
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# CORS Configuration
# Comma-separated list of allowed origins (leave empty to block all cross-origin requests)
CORS_ALLOWED_ORIGINS=

# Prometheus Metrics Access
# /api/metrics exposes version and business telemetry. Admit a scraper by its
# source IP or by a bearer token. With both empty the endpoint is unreachable
# in production and open outside it.
# Behind a reverse proxy, prefer the token: TrustProxies is not configured, so
# the observed source IP is the proxy's. See config/metrics.php.
METRICS_ALLOWED_IPS=
METRICS_TOKEN=

# Outbound Fetch Controls
# Hosts the server may contact when the address came from data it did not
# choose - certificate revocation endpoints are read from inside the
# certificate being validated. Comma-separated; a leading dot allows that
# zone's subdomains. Leave empty and the fallback applies: https only, and
# the host must not resolve to a private, loopback or link-local address.
REVOCATION_ALLOWED_HOSTS=
OUTBOUND_FETCH_TIMEOUT=10
OUTBOUND_FETCH_MAX_BYTES=5242880

# API Key Hashing
# Mixed into API key hashes so a leaked api_keys table cannot be attacked
# offline. Setting or changing this invalidates every key issued before it.
API_KEY_PEPPER=

# Rate Limits (per tenant, per minute, per cost band)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_SUBMISSION=30
RATE_LIMIT_ONBOARDING=5
RATE_LIMIT_READ=120
RATE_LIMIT_ANONYMOUS=20

# Signing Credential Storage
# Where each taxpayer's CSID credentials are kept. The default is the
# container's own filesystem, which confines the platform to one replica:
# a tenant onboarded on one instance cannot sign on another. Point this at a
# shared, private disk before scaling out.
ZATCA_CREDENTIAL_DISK=local

# The secret those credentials are encrypted under. Empty falls back to
# APP_KEY, which also protects sessions and cookies and sits in every
# container - a wide blast radius for signing keys. Set this, keep the old
# value in PREVIOUS_KEYS, run masaar:rotate-credential-key, then clear it.
ZATCA_CREDENTIAL_KEY=
ZATCA_CREDENTIAL_PREVIOUS_KEYS=

# ZATCA E-Invoicing Configuration
ZATCA_ENVIRONMENT=sandbox
ZATCA_USERNAME=
ZATCA_PASSWORD=
ZATCA_CERTIFICATE_PATH=
ZATCA_PRIVATE_KEY_PATH=
ZATCA_CERT_WARNING_DAYS=30
ZATCA_CERT_CRITICAL_DAYS=7
ZATCA_TIMEOUT=30
ZATCA_CONNECT_TIMEOUT=10
ZATCA_RETRY_ATTEMPTS=3
ZATCA_RETRY_DELAY=1000
ZATCA_SSL_VERIFY=true

# ZATCA Rate Limits
ZATCA_RATE_LIMIT_PER_MINUTE=60
ZATCA_RATE_LIMIT_PER_DAY=10000
ZATCA_MAX_CONCURRENT=10

# ZATCA Offline Mode
ZATCA_OFFLINE_ENABLED=true
ZATCA_OFFLINE_QUEUE_MAX=10000
ZATCA_OFFLINE_RETRY_INTERVAL=300
ZATCA_OFFLINE_MAX_ATTEMPTS=3
ZATCA_CONNECTIVITY_CHECK_INTERVAL=30
ZATCA_CONNECTIVITY_TIMEOUT=10
ZATCA_CONNECTIVITY_FAILURE_THRESHOLD=3
ZATCA_CONNECTIVITY_CIRCUIT_DURATION=60
ZATCA_LOCAL_SIGNING_ENABLED=true
ZATCA_LOCAL_QR_ENABLED=true
ZATCA_LOCAL_STORAGE_FALLBACK=true
# ZATCA_FALLBACK_PATH=
ZATCA_AUTO_RECOVERY_ENABLED=true
ZATCA_AUTO_RECOVERY_BATCH=50
ZATCA_AUTO_RECOVERY_DELAY=5
ZATCA_AUTO_RECOVERY_BACKGROUND=true
ZATCA_POS_MODE_ENABLED=false
ZATCA_POS_IMMEDIATE_QR=true
ZATCA_POS_MAX_OFFLINE_VALUE=50000
ZATCA_POS_QUEUE_WARNING=100

# ZATCA Timestamp Authority (optional, for XAdES-T)
ZATCA_TSA_ENABLED=false
# ZATCA_TSA_URL=
# ZATCA_TSA_USERNAME=
# ZATCA_TSA_PASSWORD=
ZATCA_TSA_TIMEOUT=30

# ZATCA Feature Flags
ZATCA_FEATURE_ASYNC=true
ZATCA_FEATURE_OFFLINE=true
ZATCA_FEATURE_CIRCUIT_BREAKER=true
ZATCA_FEATURE_TSA=false
ZATCA_FEATURE_CRL_CHECK=true
ZATCA_FEATURE_ARABIC_NORM=true

# ZATCA Queue
# Empty means the application's own QUEUE_CONNECTION. Set it only to put ZATCA
# work on a separate connection, and make sure a worker runs there — this said
# redis while QUEUE_CONNECTION is database, and nothing read it, so the setting
# described a topology the platform was not using.
ZATCA_QUEUE_CONNECTION=
# Workers must be started on these names, or submissions and webhook deliveries
# queue for ever with nothing to process them:
#   php artisan queue:work --queue=zatca-submissions,webhooks,default
ZATCA_QUEUE_NAME=zatca-submissions
ZATCA_QUEUE_WEBHOOKS=webhooks
ZATCA_QUEUE_TRIES=3
ZATCA_QUEUE_TIMEOUT=120

# ZATCA Idempotency
ZATCA_IDEMPOTENCY_HOURS=24

# ZATCA Thresholds
ZATCA_LARGE_INVOICE_THRESHOLD=1000000

# ZATCA Circuit Breaker
ZATCA_CCB_FAILURE_THRESHOLD=5
ZATCA_CCB_SUCCESS_THRESHOLD=3
ZATCA_CCB_TIMEOUT=60
ZATCA_CCB_HALF_OPEN_REQUESTS=3

# ZATCA Kill Switch
ZATCA_KS_MAX_DURATION=14400
ZATCA_KS_ALERT_THRESHOLD=1800
ZATCA_KS_CACHE_TTL=3600

# ZATCA Hash Chain
ZATCA_HASH_CHAIN_LOCK_TIMEOUT=30
ZATCA_HASH_CHAIN_MONITORING=true
ZATCA_HASH_CHAIN_P95_WARNING=50
ZATCA_HASH_CHAIN_P99_CRITICAL=200
ZATCA_HASH_CHAIN_SAMPLE_INTERVAL=5
ZATCA_HASH_CHAIN_ALERT=true

# ZATCA Strict Exemption Codes
ZATCA_STRICT_EXEMPTION_CODES=false

# ZATCA Certificate Notifications
ZATCA_CERT_NOTIFICATIONS_ENABLED=true
ZATCA_CERT_NOTIFY_CHANNELS=mail,webhook

# Platform License Configuration
# Gates the whole API: PlatformLicense runs on every /api route and answers 403
# when the key is missing, expired or unrecognised.
#
# Off by default because a fresh checkout has no key, and enabled with an empty
# PLATFORM_LICENSE_KEY means "enforce, with nothing to enforce against" — every
# request refused. That combination shipped as the default and was harmless only
# because the middleware was attached to no route. Production sets this true and
# supplies a key.
PLATFORM_LICENSE_ENABLED=false
PLATFORM_LICENSE_KEY=
PLATFORM_LICENSE_SERVER_URL=https://license.your-domain.com
PLATFORM_LICENSE_SECRET=
PLATFORM_LICENSE_WARNING_DAYS=7
PLATFORM_LICENSE_CACHE_SECONDS=3600

# Licensing Module
LICENSE_CACHE_ENABLED=true
LICENSE_CACHE_TTL=300
LICENSE_AUDIT_ENABLED=true
LICENSE_AUDIT_RETENTION_DAYS=730

# UAE FTA E-Invoicing
# The second jurisdiction this platform serves. Every one of these settings was
# read from the environment and named nowhere, so an operator deploying UAE
# compliance had nothing to set: submissions went to the sandbox with no
# credential and failed at the authority rather than at startup.
#
# Leave the environment on sandbox until the credentials below are real.
UAE_FTA_ENVIRONMENT=sandbox
UAE_FTA_SANDBOX_URL=https://sandbox-einvoicing.tax.gov.ae/api/v1
UAE_FTA_PRODUCTION_URL=https://einvoicing.tax.gov.ae/api/v1

# Issued by the FTA, and the only credential the submission path uses. Empty
# here on purpose — a secret in a committed file is a leaked secret.
UAE_FTA_API_KEY=

UAE_FTA_TIMEOUT=30

# Where the ZATCA UBL 2.1 schema set is unpacked, from their SDK download. With
# this unset, generated XML is checked for well-formedness only - it is not
# validated against the specification.
# ZATCA_SCHEMA_PATH=resources/zatca/xsd/maindoc/UBL-Invoice-2.1.xsd
